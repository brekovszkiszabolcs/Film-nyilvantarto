<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0"
      style="-fx-background-color: #000000;" stylesheets="@../styles/dark-theme.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.MovieListController">
    <children>

        <!-- FEJLÉC ÉS MENÜ -->
        <VBox style="-fx-background-color: #1a1a1a; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 5);">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#goBackToMain" text="← Kijelentkezés"
                                style="-fx-background-color: transparent; -fx-text-fill: #999999; -fx-border-color: #999999; -fx-border-radius: 3; -fx-cursor: hand;" />
                        <Label text="SAJÁT FILMEK NYILVÁNTARTÁSA" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </HBox>

                <!-- ESZKÖZTÁR (Új film + Kereső + Szűrők) -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleNewFilm" text="+ Új film felvétele"
                                style="-fx-background-color: #00cc66; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;"/>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- ÚJ: Cím alapú keresőmező nagyítóval -->
                        <VBox spacing="5">
                            <Label text="Keresés:" textFill="#cccccc"/>
                            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #2b2b2b; -fx-border-color: #555555; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 2;">
                                <TextField fx:id="searchField" promptText="Film címe..." prefWidth="200.0"
                                           style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: #888888; -fx-border-width: 0;" />
                                <Label text="🔍" style="-fx-text-fill: #aaaaaa; -fx-font-size: 14px;" />
                            </HBox>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <VBox spacing="5">
                            <Label text="Rendezés:" textFill="#cccccc"/>
                            <ComboBox fx:id="sortComboBox" onAction="#filterAndSortMovies" prefWidth="200.0" />
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Műfaj szűrő:" textFill="#cccccc"/>
                            <ComboBox fx:id="genreFilter" onAction="#filterAndSortMovies" prefWidth="200.0" />
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- FILMEK KÁRTYÁI -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" style="-fx-background: #000000; -fx-background-color: transparent;">
            <content>
                <VBox fx:id="movieListContainer" spacing="20.0" style="-fx-background-color: #000000; -fx-padding: 20;">
                    <!-- A Java kód ide fogja generálni a kártyákat -->
                </VBox>
            </content>
        </ScrollPane>

    </children>
</VBox>